<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.oberon-oss</groupId>
        <artifactId>project-settings-parent</artifactId>
        <version>4.25.5</version>
    </parent>

    <groupId>eu.oberon-oss.tools</groupId>
    <artifactId>data-converters</artifactId>
    <version>1.0.1-SNAPSHOT</version>

    <name>Data Converters and Binary Data Reader library</name>
    <description>
        Unified library providing bidirectional converters for string, binary, and custom types, along with binary data reading and value retrieval.
    </description>

    <scm>
        <connection>scm:git:https://github.com/oberon-oss/data-converters.git.</connection>
        <developerConnection>scm:git@github.com:oberon-oss/data-converters.git</developerConnection>
        <url>https://github.com/oberon-oss/data-converters</url>
    </scm>

    <properties>
        <!--suppress XmlUnresolvedReference -->
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <argLine/>
        <sonar.projectKey>oberon-oss_data-converters</sonar.projectKey>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- test dependencies -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <repositories>
        <repository>
            <id>nexus-releases</id>
            <name>Nexus Release Repository</name>
            <url>https://nexus.oberon-oss.eu/repository/maven-releases/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>

        <repository>
            <id>nexus-snapshots</id>
            <name>Nexus Release Repository</name>
            <url>https://nexus.oberon-oss.eu/repository/maven-snapshots/</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>
</project>
